# Dependencies
node_modules

# Environment variables — never commit real credentials.
# Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Build output
dist
/generated/prisma

# User-uploaded files. These are runtime data, not source: they are large,
# they differ per environment, and member registration documents in here are
# personal information that must not end up in a repository.
uploads/*
!uploads/.gitkeep

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
