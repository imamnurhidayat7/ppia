# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Variable names mirror the running configuration; every value here is a
# placeholder. Nothing in this file is a real credential.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Public base URL of this API, used when building absolute links in e-mails.
API_URL=http://localhost:4000

# Origin of the Next.js app, used for CORS and for links in e-mails.
FRONTEND_URL=http://localhost:3000

# ─── Where data lives: one switch ────────────────────────────────────────────
# DATA_SOURCE picks the database AND the file storage together, so the two can
# never end up pointing at different environments by accident.
#
#   local     → LOCAL_DATABASE_URL     + uploads on disk
#   supabase  → SUPABASE_DATABASE_URL  + Supabase Storage buckets
#
# Flip this one line to move between them; nothing else needs editing.
DATA_SOURCE=local

# ─── Database: local Postgres ────────────────────────────────────────────────
# Used when DATA_SOURCE=local. This is a normal Postgres installed on your
# machine — no Docker required:
#   brew install postgresql@16 && brew services start postgresql@16
#   createdb ppia
#
# The default below assumes a `postgres` superuser on the standard port. With a
# Homebrew install the role is usually your own username and needs no password:
#   postgresql://YOUR_USERNAME@localhost:5432/ppia?schema=public
#
# If you prefer the bundled container (docker-compose.dev.yml), use port 5433:
#   postgresql://ppia:ppia_local_dev@localhost:5433/ppia?schema=public
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppia?schema=public

# ─── Database: Supabase ──────────────────────────────────────────────────────
# Used when DATA_SOURCE=supabase.
#   SUPABASE_DATABASE_URL  runtime connection (the pooled 6543 port is fine)
#   SUPABASE_DIRECT_URL    direct 5432 connection, required for migrations —
#                          DDL cannot run through the transaction pooler
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=

# ─── Database: manual override ───────────────────────────────────────────────
# Setting these wins over DATA_SOURCE. Leave them empty unless a host injects
# DATABASE_URL for you (Render, Fly, Heroku), in which case it is used as-is.
DATABASE_URL=
DIRECT_URL=

# ─── File storage ────────────────────────────────────────────────────────────
# Normally left empty: storage follows DATA_SOURCE. Set it only to override.
#   local     — write to api/uploads (public) and api/storage/private (personal
#               documents, served only through short-lived signed links).
#   supabase  — write to Supabase Storage buckets. Use this in deployment, where
#               the filesystem is ephemeral and may be replicated.
STORAGE_DRIVER=

# ─── Authentication ──────────────────────────────────────────────────────────
# Signing secret for JSON Web Tokens. Use a long random string, unique per
# environment. Rotating this invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-string

# ─── E-mail (Mailtrap) ───────────────────────────────────────────────────────
# Transactional mail goes through the Mailtrap HTTP API (see src/lib/mailer.ts).
#
# When MAILTRAP_USE_SANDBOX=true nothing is delivered to real recipients; every
# message lands in the Mailtrap inbox identified by MAILTRAP_INBOX_ID. Set it to
# false only once the sending domain is verified in Mailtrap.
#
# If MAILTRAP_TOKEN is empty the API keeps running and logs e-mails instead of
# sending them, so local development works without credentials.
MAILTRAP_USE_SANDBOX=true

# API token for Mailtrap sending. MAILTRAP_API_KEY is accepted as an alias.
MAILTRAP_TOKEN=
MAILTRAP_API_KEY=

# Required only when MAILTRAP_USE_SANDBOX=true.
MAILTRAP_INBOX_ID=

# Envelope sender. In production the domain must be verified in Mailtrap.
MAIL_FROM=no-reply@ppiaauckland.org
MAIL_FROM_NAME=PPIA Auckland

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Number of reverse proxies in front of this process, so Express can read the
# real client address from X-Forwarded-For. Use 1 behind a single nginx or load
# balancer. Leave unset when the process is reached directly — trusting the
# header without a proxy would let any caller spoof its address and bypass the
# rate limiter.
TRUST_PROXY=

# Set to true to switch off rate limiting. Intended for local development only.
RATE_LIMIT_DISABLED=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# FRONTEND_URL above is always allowed. Add extra browser origins here as a
# comma-separated list (staging host, custom domain). localhost:3000 and
# localhost:3001 are always allowed for local development.
CORS_ORIGINS=

# ─── File storage: Supabase (deployment only) ────────────────────────────────
# Needed only when STORAGE_DRIVER=supabase. Leave these empty for local
# development and uploads go to disk instead. Server-side uploads use the
# service-role key, which must never be exposed to the browser.
#
# SUPABASE_URL          Project URL, e.g. https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY  The `service_role` secret from Project Settings → API
# SUPABASE_STORAGE_BUCKET    Name of the PUBLIC bucket for images
# SUPABASE_STORAGE_PRIVATE_BUCKET  Name of the PRIVATE bucket for documents (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_STORAGE_PRIVATE_BUCKET=
