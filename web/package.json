{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect --url=http://localhost:3001",
    "perf:test": "bash ../scripts/perf-test.sh",
    "perf:lighthouse": "bash ../scripts/perf-lighthouse.sh",
    "perf:api": "bash ../scripts/perf-api.sh",
    "perf:bundle": "ANALYZE=true next build"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "isomorphic-dompurify": "^2.28.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "//overrides.jsdom": "Pinned below isomorphic-dompurify's declared ^27 on purpose. jsdom 27 pulls html-encoding-sniffer@6, which reaches @exodus/bytes — an ESM-only package — through a CommonJS require(). Next externalises jsdom from the server bundle, so that require() runs at request time and throws ERR_REQUIRE_ESM on any Node older than 22.12, taking down every server-rendered route while prerendered pages kept working. jsdom 26 uses html-encoding-sniffer@4, whose only dependency (whatwg-encoding) is CommonJS, so the failure cannot happen regardless of the host's Node version. jsdom is only here to give DOMPurify a DOM to parse into; the API used (new JSDOM('').window) is unchanged between 26 and 27.",
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "4.23.0",
    "typescript": "^5"
  }
}
