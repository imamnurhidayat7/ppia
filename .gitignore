# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment variables — never commit real credentials ─────
# Copy the .env.example files and fill them in locally.
.env
.env.*
!.env.example
# web uses .env.local; keep it out but allow an example if one is added
!.env.local.example

# ── Build output ─────────────────────────────────────────────
# Next.js (web)
.next/
out/
/build
next-env.d.ts
*.tsbuildinfo
# Express/TypeScript (api)
dist/
/generated/prisma
api/generated/prisma

# ── Runtime data ─────────────────────────────────────────────
# User uploads are large, environment-specific, and may contain
# personal information (member registration documents).
api/uploads/*
!api/uploads/.gitkeep

# ── Testing / coverage ───────────────────────────────────────
/coverage

# ── Deploy ───────────────────────────────────────────────────
.vercel

# ── Logs & OS noise ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem

# ── AI tooling / skills (not application source) ─────────────
# These are local agent/skill directories, not part of the app.
.claude/
_bmad/
.superpowers/
.github/prompts/

# ── Local backup of the pre-merge git histories (safe to delete) ─
.git-backup/
